set_global_assignment -name SYSTEMVERILOG_FILE RELU3.sv
set_global_assignment -name SYSTEMVERILOG_FILE stg1flops.sv
set_global_assignment -name SYSTEMVERILOG_FILE d_ff.sv
set_global_assignment -name SYSTEMVERILOG_FILE d_en_ff.sv
